{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "regions": [
        "arn1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "vehicle"
        }
      ],
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lines"
        }
      ],
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "hLine"
        }
      ],
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}